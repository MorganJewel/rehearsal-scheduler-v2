# ============================================================
# REHEARSAL SCHEDULER - ENVIRONMENT VARIABLES
# ============================================================
# 
# CRITICAL: This file is a TEMPLATE ONLY
# Create .env.local in your local machine with actual values
# DO NOT COMMIT .env.local to GitHub
#
# Copy this to .env.local and fill in your actual values:
# cp .env.example .env.local
#
# ============================================================

# ============================================================
# SUPABASE CONFIGURATION (PUBLIC - Safe to share)
# ============================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# SUPABASE CONFIGURATION (PRIVATE - GitHub Secrets only)
# ============================================================
# These go in GitHub Secrets, NOT in .env files
# 
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=same-as-service-key
#
# How to add to GitHub:
# 1. Go to repo Settings > Secrets and variables > Actions
# 2. Click "New repository secret"
# 3. Name: SUPABASE_SERVICE_KEY
# 4. Value: your-service-key-from-supabase-dashboard
# 5. Click "Add secret"
#
# These are automatically available in GitHub Actions workflows
# via: process.env.SUPABASE_SERVICE_KEY

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# App environment
VITE_APP_ENV=development
# Options: development, staging, production

# App name & version
VITE_APP_NAME=Rehearsal Scheduler
VITE_APP_VERSION=2.0.0

# API configuration
VITE_API_TIMEOUT=30000
# Milliseconds before API request times out

# Feature flags
VITE_ENABLE_MFA=false
# Set to true in production to require 2FA for admins

VITE_ENABLE_ANALYTICS=false
# Set to true in production to track usage metrics

VITE_ENABLE_BACKUP_WARNINGS=true
# Alert users about backup status

# ============================================================
# SECURITY SETTINGS
# ============================================================

# Rate limiting
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW_MINUTES=1
# 100 requests per minute per user

# Session timeout (minutes)
VITE_SESSION_TIMEOUT=60
# Auto-logout after 60 minutes of inactivity

# Password policy
VITE_PASSWORD_MIN_LENGTH=12
VITE_PASSWORD_REQUIRE_UPPERCASE=true
VITE_PASSWORD_REQUIRE_NUMBERS=true
VITE_PASSWORD_REQUIRE_SPECIAL=true

# ============================================================
# ACCESSIBILITY & UI
# ============================================================

# Accessibility level
VITE_A11Y_LEVEL=AAA
# Options: AA (standard), AAA (highest)

# Theme
VITE_DEFAULT_THEME=light
# Options: light, dark, auto

# Language
VITE_DEFAULT_LANGUAGE=en
# Options: en, es, fr, de

# ============================================================
# LOGGING & MONITORING
# ============================================================

# Log level
VITE_LOG_LEVEL=info
# Options: debug, info, warn, error

# Error reporting
VITE_ERROR_REPORTING_ENABLED=false
# Send errors to monitoring service (in production)

# ============================================================
# DEVELOPMENT ONLY
# ============================================================

# Enable debug mode
VITE_DEBUG=false
# Shows extra logging, skips some validations

# Mock data for testing
VITE_ENABLE_MOCK_DATA=false
# Populates app with sample productions/schedules

# API mock mode (skip real Supabase)
VITE_MOCK_API=false
# Use local mock API instead of Supabase

# ============================================================
# HOW TO CREATE YOUR .env.local FILE
# ============================================================
#
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Get your Supabase credentials:
#    - Go to supabase.com dashboard
#    - Select your project
#    - Settings > API
#    - Copy the URL and Anon Key
#
# 3. Fill in the values:
#    VITE_SUPABASE_URL=https://your-project-id.supabase.co
#    VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# 4. Never commit .env.local:
#    git add .env.local  # ❌ WRONG
#    git add .env.local  # ✅ BLOCKED by .gitignore
#
# 5. Each team member creates their own .env.local
#
# ============================================================
# VERIFYING YOUR SETUP
# ============================================================
#
# After creating .env.local, test it:
#
# npm run dev
#
# Check browser console:
# - No "undefined URL" errors ✅
# - App loads without 401 errors ✅
# - Can see sample data ✅
#
# If you see errors, check:
# - URL is correct (https://xxx.supabase.co)
# - Anon key is complete (starts with eyJ...)
# - .env.local is in project root
# - Server restarted after creating .env.local
#
# ============================================================
# SECURITY BEST PRACTICES
# ============================================================
#
# ✅ DO:
# - Keep .env.local in .gitignore
# - Use strong passwords
# - Rotate API keys monthly
# - Never share .env.local files
# - Use different keys per environment
# - Enable MFA in production
# - Review audit logs regularly
#
# ❌ DON'T:
# - Commit .env files to Git
# - Share API keys via email/Slack
# - Reuse keys across projects
# - Use dev credentials in production
# - Leave test keys lying around
# - Hardcode secrets in code
# - Put secrets in comments
#
# ============================================================
# ENVIRONMENT-SPECIFIC CONFIGS
# ============================================================
#
# Local Development (.env.local):
# - Relaxed rate limits
# - Debug mode enabled
# - Mock data available
# - Analytics disabled
# - Error reporting disabled
#
# Staging (GitHub Secrets - STAGING_*):
# - Production-like settings
# - Reduced rate limits
# - Error reporting enabled
# - Real Supabase project
# - Can use test data
#
# Production (GitHub Secrets - PROD_*):
# - All security features enabled
# - Rate limiting enforced
# - MFA required for admins
# - Monitoring & alerts active
# - Analytics enabled
# - Backup validation strict
#
# ============================================================
