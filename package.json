{
  "name": "rehearsal-scheduler-v2",
  "version": "2.0.0",
  "description": "Enterprise-grade rehearsal scheduling tool for theater productions with team collaboration, accessibility (WCAG AAA), and security-first architecture",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Rehearsal Scheduler Team",
  "homepage": "https://github.com/yourusername/rehearsal-scheduler-v2",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rehearsal-scheduler-v2.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/rehearsal-scheduler-v2/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:security": "npm audit && node scripts/security-check.js",
    "test:a11y": "jest --testPathPattern=a11y",
    "test:all": "npm run test && npm run test:e2e && npm run test:security",
    "vitest": "vitest",
    "vitest:ui": "vitest --ui",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"docs/**/*.md\"",
    "type-check": "tsc --noEmit",
    "backup": "node scripts/backup.js",
    "backup:restore": "node scripts/restore.js",
    "backup:verify": "node scripts/verify-backup.js",
    "db:seed": "node scripts/seed-data.js",
    "db:migrate": "node scripts/migration.js",
    "security:rotate-keys": "node scripts/rotate-keys.js",
    "docs:build": "node scripts/build-docs.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "@supabase/auth-ui-vue": "^0.4.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "dotenv": "^16.3.1",
    "js-cookie": "^3.0.5",
    "date-fns": "^2.30.0",
    "uuid": "^9.0.0",
    "lodash-es": "^4.17.21",
    "signal-exit": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/dom": "^9.3.3",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@vitest/ui": "^1.0.4",
    "vitest": "^1.0.4",
    "@playwright/test": "^1.40.1",
    "playwright": "^1.40.1",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "vite": "^5.0.7",
    "typescript": "^5.3.3",
    "@axe-core/react": "^4.8.0",
    "jest-axe": "^8.0.0",
    "wcag-contrast": "^3.0.1"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "docs/**/*.md": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/frontend-tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "vitest": {
    "globals": true,
    "environment": "jsdom",
    "setupFiles": [
      "./frontend-tests/setup.js"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 100,
    "arrowParens": "always"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "extends": [
      "airbnb-base"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": [
        "warn",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "prefer-destructuring": "warn",
      "no-param-reassign": [
        "error",
        {
          "props": false
        }
      ]
    }
  },
  "keywords": [
    "theater",
    "rehearsal",
    "scheduling",
    "production",
    "collaboration",
    "accessibility",
    "wcag",
    "security",
    "supabase",
    "postgresql"
  ]
}
